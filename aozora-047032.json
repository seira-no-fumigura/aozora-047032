   "vol": "",
   "kotobagaki": "",
   "author": "",
   "text": "巨細相兼不並侵、審論始識適幽襟、鶴翁才気元天性、琴叟文章見苦心、戯譃諷人豈云浅、悲歌寓意一何深、梅花香底伝佳話、只少黄昏春月臨",
   "sachu": "",
   "poems": [],
   "notes": [],
   "lb": [],
   "form": "prose"
  },
